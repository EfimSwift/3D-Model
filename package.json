{
  "name": "3d-model",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "prisma db push && prisma db seed",
    "cf:bootstrap": "node scripts/cf-bootstrap.mjs",
    "cf:check": "node scripts/cf-check.mjs",
    "cf:db:schema": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script -o prisma/cloudflare-schema.sql",
    "cf:db:migrate:local": "wrangler d1 execute figurki-3d-dev --local --file=prisma/cloudflare-schema.sql",
    "cf:db:migrate:remote": "wrangler d1 execute figurki-3d-dev --remote --file=prisma/cloudflare-schema.sql",
    "cf:db:seed:remote": "tsx scripts/cf-seed-d1.ts",
    "cf:models:upload": "node scripts/cf-upload-models.mjs",
    "cf:finish-r2": "node scripts/cf-finish-r2.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:check && npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:check && npm run cf:build && opennextjs-cloudflare deploy",
    "cf:upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.6.5",
    "@prisma/adapter-d1": "6.16.2",
    "@prisma/client": "6.16.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "redis": "^5.8.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "wrangler": "^4.36.0"
  }
}
