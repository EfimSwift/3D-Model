{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3d-model",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // OpenNext уже в `npm run cf:workers-ci` — не дублировать build здесь
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "3d-model",
    },
  ],
  // После: npx wrangler d1 create figurki-3d-dev — подставьте database_id
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "figurki-3d-dev",
      "database_id": "d0b0a67f-1fd2-4fbf-b8fe-fa5578193ec4",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MODELS_BUCKET",
      "bucket_name": "figurki-3d-models-dev",
    },
    // Опционально: кэш Next.js (см. open-next.config.ts)
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "figurki-3d-next-cache-dev",
    // },
  ],
  "vars": {
    // Placeholder для Prisma schema; реальные запросы идут через D1 adapter
    "DATABASE_URL": "file:./cloudflare-d1.sqlite",
    "NEXT_PUBLIC_APP_URL": "https://3d-model.a01871893.workers.dev",
    "ENABLE_TEST_PAYMENT": "true",
    "ALLOW_TEST_PAYMENT_IN_PRODUCTION": "false",
  },
  "env": {
    "preview": {
      "name": "3d-model-preview",
      "vars": {
        "NEXT_PUBLIC_APP_URL": "https://3d-model-preview.workers.dev",
        "ENABLE_TEST_PAYMENT": "true",
      },
    },
  },
}
