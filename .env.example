DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-long-random-string"
# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MODEL_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
ENABLE_TEST_PAYMENT="true"
# На production не включать. Тестовая кнопка оплаты только для dev.
ALLOW_TEST_PAYMENT_IN_PRODUCTION="false"
PAYMENT_WEBHOOK_SECRET="replace-with-webhook-hmac-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Docker Compose: redis://redis:6379
REDIS_URL=""

# --- Cloudflare Workers (dev): см. docs/CLOUDFLARE-DEV.md ---
# Секреты задаются через: npx wrangler secret put ...
# Публичные vars — wrangler.jsonc. Локальный preview: .dev.vars (из .dev.vars.example)
