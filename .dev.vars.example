# Локальный preview: cp .dev.vars.example .dev.vars
NEXTJS_ENV=development

DATABASE_URL="file:./prisma/dev.db"
SESSION_SECRET="dev-session-secret-min-32-chars-long!!"
MODEL_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
ENABLE_TEST_PAYMENT="true"
ALLOW_TEST_PAYMENT_IN_PRODUCTION="false"
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
NEXT_PUBLIC_APP_URL="http://localhost:8788"
REDIS_URL=""
